{
  "id": "./",
  "name": "SlipTrace — Betting Tracker",
  "short_name": "SlipTrace",
  "description": "Track every slip with a local-first betting journal for bankroll, reports, and performance.",
  "lang": "en",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#07101f",
  "theme_color": "#0b1220",
  "orientation": "any",
  "categories": ["sports", "finance", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "assets/sliptrace-app-icon.svg?v=20260727-3",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "assets/sliptrace-app-icon.svg?v=20260727-3",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add Bet",
      "short_name": "Add Bet",
      "description": "Open SlipTrace manual bet entry.",
      "url": "./bets.html?add=1"
    },
    {
      "name": "Reports",
      "short_name": "Reports",
      "description": "Open weekly and monthly performance reports.",
      "url": "./reports.html"
    },
    {
      "name": "Calendar",
      "short_name": "Calendar",
      "description": "Open the settled-results calendar.",
      "url": "./calendar.html"
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  }
}